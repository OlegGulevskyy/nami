#!/bin/sh
# Runs the nami-actions CLI, building it first when it is missing or out of date.
# Safe to symlink onto your PATH.
set -e
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bin="$root/.build/release/nami-actions"
if [ ! -x "$bin" ] || [ -n "$(find "$root/Sources/NamiCore" "$root/Sources/NamiActions" -name '*.swift' -newer "$bin" | head -1)" ]; then
    swift build -c release --package-path "$root" --product nami-actions >&2
fi
exec "$bin" "$@"
